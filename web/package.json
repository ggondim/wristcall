{
  "name": "wristcall-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "npm run typecheck && vite build && vite build -c vite.sw.config.ts",
    "check:dist": "node scripts/check-dist.mjs",
    "preview": "vite preview --port 5173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sw.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.4",
    "@types/node": "24.19.2",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.14.6",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
