<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>voip</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wristcall</string>
			</array>
		</dict>
	</array>
	<!-- AgentCatalog.shared(): the App Group shared with the widget extension (decision W13). -->
	<key>WristcallAppGroup</key>
	<string>group.$(BUNDLE_ID_PREFIX).wristcall</string>
	<!-- Keychain access group of the account keys (the watch only reads them); same value as the entitlement. Empty prefix without a team. -->
	<key>WristcallKeychainGroup</key>
	<string>$(AppIdentifierPrefix)io.github.ggondim.wristcall.shared</string>
	<!-- The Cloud for the account login (empty: the watch has no account login). -->
	<key>WristcallCloudURL</key>
	<string>$(WRISTCALL_CLOUD_URL)</string>
	<!-- Product version sent to the Cloud (X-Wristcall-Client); set per target in project.yml. -->
	<key>WristcallClientVersion</key>
	<string>$(WRISTCALL_CLIENT_VERSION)</string>
	<!-- Push relay (Cloud) and APNs environment: set by Config/Push.xcconfig, empty (push off) otherwise. -->
	<key>WristcallRelayURL</key>
	<string>$(WRISTCALL_RELAY_URL)</string>
	<key>WristcallPushEnvironment</key>
	<string>$(WRISTCALL_PUSH_ENVIRONMENT)</string>
</dict>
</plist>
