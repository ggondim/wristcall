// Shared build settings for the wristcall watch app (all targets, all configurations).
//
// Personal signing values go in Config/Local.xcconfig, which is gitignored:
//
//   DEVELOPMENT_TEAM = ABCDE12345
//   BUNDLE_ID_PREFIX = com.example.yourname
//
// A free Apple ID (Personal Team) works; see watch/README.md.

BUNDLE_ID_PREFIX = io.github.ggondim
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

// The wristcall Cloud the apps talk to for the account (sign in, agenda). Empty: no account, the apps
// work with servers and tokens alone. The production URL goes here at deploy time; a local one can go
// in Config/Local.xcconfig or `make ... CLOUD_URL=http://127.0.0.1:8090` (`$()` keeps `//` from
// starting a comment in an xcconfig).
WRISTCALL_CLOUD_URL =

#include? "Local.xcconfig"
