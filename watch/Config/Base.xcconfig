// Shared build settings for the wristcall watch app (all targets, all configurations).
//
// Personal signing values go in Config/Local.xcconfig, which is gitignored:
//
//   DEVELOPMENT_TEAM = ABCDE12345
//   BUNDLE_ID_PREFIX = com.example.yourname
//
// A free Apple ID (Personal Team) works; see watch/README.md.

BUNDLE_ID_PREFIX = io.github.ggondim
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

// The Wristcall Cloud the apps talk to for the account (sign in, agenda): the project's production
// Cloud. Empty means no account, the apps work with servers and tokens alone. Another one (a local
// Cloud) can go in Config/Local.xcconfig or `make ... CLOUD_URL=http://127.0.0.1:8090` (`$()` keeps
// `//` from starting a comment in an xcconfig).
WRISTCALL_CLOUD_URL = https:/$()/wristcall-cloud.trigram.com.br

#include? "Local.xcconfig"
